# The visor borrow: compile the submodule's sources straight from
# third_party/visor. Nothing inside that tree is modified or copied.
# add_subdirectory is not an option on purpose -- visor's own CMakeLists
# resolves its include path against CMAKE_SOURCE_DIR and requires X11
# unconditionally, both of which only hold while visor is the root project.
#
# Upstream: https://github.com/Awesome-Embedded-Learning-Studio/visor
# The pin lives in this repo's history as the submodule gitlink; moving it is
# a commit, and both sides' acceptance rerun before it moves.

set(VISOR_ROOT "${CMAKE_SOURCE_DIR}/third_party/visor")
if(NOT EXISTS "${VISOR_ROOT}/include/visor/bindings/host.hpp")
    message(FATAL_ERROR
        "third_party/visor is empty. Run: git submodule update --init")
endif()

add_library(visor.core INTERFACE)
target_include_directories(visor.core INTERFACE ${VISOR_ROOT}/include)

# The glob follows the live tree so a new visor source file joins the build by
# itself; visor runs its own checks in its own repo.
file(GLOB_RECURSE VESPER_VISOR_UI_SOURCES CONFIGURE_DEPENDS ${VISOR_ROOT}/src/ui/*.cpp)
add_library(visor.ui STATIC ${VESPER_VISOR_UI_SOURCES})
target_link_libraries(visor.ui PUBLIC visor.core)

# The host library carries the two pure bindings beside the table itself:
# the evdev word translator (keys, buttons, relative axes) and the cinux
# frame expansion (mono bits into XRGB8888 words). Both are plain logic
# with no system dependency, so they ride the core host target; the X11
# binding stays separate below because it links a real library.
add_library(visor.host STATIC
    ${VISOR_ROOT}/src/bindings/host.cpp
    ${VISOR_ROOT}/src/bindings/evdev/event_wire.cpp
    ${VISOR_ROOT}/src/bindings/cinux/frame_expand.cpp)
target_link_libraries(visor.host PUBLIC visor.core)

# The eyeball lane: an X11 window running the same scene the judgments render.
# It exists to be looked at, so it is skipped without X11 and carries no test.
# Only the borrowed library lives here; the example that links it is wired up
# by the root project after its own targets exist.
find_package(X11 QUIET)
if(X11_FOUND)
    add_library(visor.host.x11 STATIC
        ${VISOR_ROOT}/src/bindings/x11/event_wire.cpp
        ${VISOR_ROOT}/src/bindings/x11/x11_window_host.cpp)
    target_link_libraries(visor.host.x11 PUBLIC visor.core X11::X11)
else()
    message(STATUS "X11 not found: the eyeball example is skipped")
endif()

# The Wayland eyeball lane, the X11 tier's own stance on the second real host:
# the window half speaks the system libwayland (a system library, not a third
# dependency), the xdg-shell half is generated by the system's wayland-scanner
# from the system's protocol XML, and nothing is vendored. Skipped without the
# three pieces, never tested by CTest.
find_package(PkgConfig QUIET)
if(PkgConfig_FOUND)
    pkg_check_modules(VESPER_WAYLAND_CLIENT QUIET IMPORTED_TARGET wayland-client>=1.26)
    pkg_check_modules(VESPER_WAYLAND_PROTOCOLS QUIET wayland-protocols)
    pkg_get_variable(VESPER_WAYLAND_PROTOCOLS_DATADIR wayland-protocols pkgdatadir)
    # Some distributions keep the scanner beside libwayland in sbin, which
    # find_program does not search by default, so the package prefix hints it.
    find_program(VESPER_WAYLAND_SCANNER
                 NAMES wayland-scanner
                 HINTS "${VESPER_WAYLAND_CLIENT_PREFIX}/bin"
                       "${VESPER_WAYLAND_CLIENT_PREFIX}/../sbin"
                       "${VESPER_WAYLAND_CLIENT_PREFIX}/sbin")
endif()
if(VESPER_WAYLAND_CLIENT_FOUND AND VESPER_WAYLAND_PROTOCOLS_FOUND AND VESPER_WAYLAND_SCANNER)
    set(VESPER_WAYLAND_GEN ${CMAKE_BINARY_DIR}/generated/wayland)
    add_custom_command(
        OUTPUT ${VESPER_WAYLAND_GEN}/xdg-shell-protocol.c
               ${VESPER_WAYLAND_GEN}/xdg-shell-client-protocol.h
        COMMAND ${CMAKE_COMMAND} -E make_directory ${VESPER_WAYLAND_GEN}
        COMMAND ${VESPER_WAYLAND_SCANNER} client-header
                ${VESPER_WAYLAND_PROTOCOLS_DATADIR}/stable/xdg-shell/xdg-shell.xml
                ${VESPER_WAYLAND_GEN}/xdg-shell-client-protocol.h
        COMMAND ${VESPER_WAYLAND_SCANNER} private-code
                ${VESPER_WAYLAND_PROTOCOLS_DATADIR}/stable/xdg-shell/xdg-shell.xml
                ${VESPER_WAYLAND_GEN}/xdg-shell-protocol.c
        DEPENDS ${VESPER_WAYLAND_PROTOCOLS_DATADIR}/stable/xdg-shell/xdg-shell.xml
        COMMENT "wayland-scanner 生成 xdg-shell 客户端代码"
        VERBATIM)
    set_source_files_properties(${VESPER_WAYLAND_GEN}/xdg-shell-protocol.c
                                PROPERTIES LANGUAGE C)
    add_library(visor.host.wayland STATIC
        ${VISOR_ROOT}/src/bindings/wayland/event_wire.cpp
        ${VISOR_ROOT}/src/bindings/wayland/wayland_window_host.cpp
        ${VESPER_WAYLAND_GEN}/xdg-shell-protocol.c)
    # The scanner's output is a generated guest, not house code: SYSTEM keeps
    # clang-tidy and clang-format from reading it as vesper's own.
    target_include_directories(visor.host.wayland SYSTEM PRIVATE ${VESPER_WAYLAND_GEN})
    target_compile_definitions(visor.host.wayland PRIVATE _GNU_SOURCE) # memfd_create
    target_link_libraries(visor.host.wayland
        PUBLIC visor.core PRIVATE PkgConfig::VESPER_WAYLAND_CLIENT)
    set(VESPER_WAYLAND_FOUND ON)
else()
    message(STATUS "wayland pieces not found: the wayland eyeball example is skipped")
endif()
